+// Fallback, falls der Universal/App-Link im BROWSER landet (App nicht installiert
+// oder Desktop). Verarbeitet den Token bewusst NICHT — der ist für die App.
+export default function AppPairFallbackPage() {
+  return (
+    <div className="min-h-screen bg-slate-50 flex items-center justify-center p-4">
+      <div className="bg-white rounded-2xl shadow-md p-8 max-w-md w-full text-center space-y-4">
+        <h1 className="text-xl font-semibold text-slate-900">EEG GrünLicht App verbinden</h1>
+        <p className="text-sm text-slate-600">
+          Dieser Link öffnet die <strong>EEG GrünLicht App</strong>. Wenn Sie ihn hier im Browser
+          sehen, ist die App auf diesem Gerät nicht installiert — oder Sie sind am Computer.
+        </p>
+        <p className="text-sm text-slate-600">
+          Öffnen Sie das Mitgliederportal auf Ihrem Handy mit installierter App und tippen Sie dort
+          unter „App verbinden“ auf „In der EEG GrünLicht App öffnen“ — oder scannen Sie den QR-Code.
+        </p>
+      </div>
+    </div>
+  );
+}
