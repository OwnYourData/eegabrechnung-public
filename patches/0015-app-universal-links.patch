diff --git a/web/app/api/well-known/aasa/route.ts b/web/app/api/well-known/aasa/route.ts
new file mode 100644
index 0000000..af48cca
--- /dev/null
+++ b/web/app/api/well-known/aasa/route.ts
@@ -0,0 +1,22 @@
+export const dynamic = "force-static";
+
+// Apple-App-Site-Association (Universal Links). Öffentlich erreichbar unter
+// /.well-known/apple-app-site-association via Rewrite in next.config.mjs.
+// Nur der Pfad /app/pair (und Unterpfade) darf die App aufrufen.
+export function GET() {
+  const body = {
+    applinks: {
+      apps: [],
+      details: [
+        {
+          appID: "39G4BK327Q.at.eeg-gruenlicht.gruenlichtApp",
+          paths: ["/app/pair", "/app/pair/*"],
+        },
+      ],
+    },
+  };
+  return new Response(JSON.stringify(body), {
+    status: 200,
+    headers: { "content-type": "application/json" },
+  });
+}
diff --git a/web/app/api/well-known/assetlinks/route.ts b/web/app/api/well-known/assetlinks/route.ts
new file mode 100644
index 0000000..47a4dea
--- /dev/null
+++ b/web/app/api/well-known/assetlinks/route.ts
@@ -0,0 +1,30 @@
+export const dynamic = "force-dynamic";
+
+// Android App Links. Öffentlich erreichbar unter /.well-known/assetlinks.json
+// via Rewrite. Die beiden SHA-256-Fingerprints kommen aus der Umgebung
+// (kein Rebuild nötig, um sie zu ändern):
+//   ANDROID_ASSETLINKS_SHA256_PLAY   — Play-App-Signing-Schlüssel (Pflicht für Store-Installationen)
+//   ANDROID_ASSETLINKS_SHA256_UPLOAD — Upload-Schlüssel (für lokale flutter-run-Builds)
+export function GET() {
+  const fps = [
+    process.env.ANDROID_ASSETLINKS_SHA256_PLAY,
+    process.env.ANDROID_ASSETLINKS_SHA256_UPLOAD,
+  ]
+    .map((f) => (f ?? "").trim())
+    .filter((f) => f.length > 0);
+
+  const body = [
+    {
+      relation: ["delegate_permission/common.handle_all_urls"],
+      target: {
+        namespace: "android_app",
+        package_name: "at.eeggruenlicht.gruenlicht_app",
+        sha256_cert_fingerprints: fps,
+      },
+    },
+  ];
+  return new Response(JSON.stringify(body, null, 2), {
+    status: 200,
+    headers: { "content-type": "application/json" },
+  });
+}
