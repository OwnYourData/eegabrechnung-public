+"use client";
+
+import { useEffect, useRef } from "react";
+
+/**
+ * Meldet das Mitglied automatisch an, sobald die Seite im Browser läuft.
+ *
+ * WARUM per JavaScript und weiterhin per POST (und NICHT per GET-Link):
+ * Der Magic-Link ist einmalig verwendbar. E-Mail-Sicherheitsgateways
+ * (Outlook SafeLinks, Virenscanner, Spam-Filter), Chat-Vorschauen und
+ * Browser-Prefetch folgen automatisch GET-Links — sie würden den Link
+ * verbrauchen, BEVOR das Mitglied ihn anklickt („Link ungültig").
+ * Ein POST wird davon nicht ausgelöst, und JavaScript führen Scanner nicht aus.
+ * So bleibt der Schutz erhalten und der Klick entfällt trotzdem.
+ *
+ * Der Button bleibt als Fallback sichtbar, falls JavaScript blockiert ist.
+ */
+export default function AutoLoginForm({ token }: { token: string }) {
+  const formRef = useRef<HTMLFormElement>(null);
+  const submitted = useRef(false);
+
+  useEffect(() => {
+    if (submitted.current) return; // niemals doppelt absenden
+    submitted.current = true;
+    formRef.current?.requestSubmit();
+  }, []);
+
+  return (
+    <form ref={formRef} action={`/portal/${token}/activate`} method="POST">
+      <button
+        type="submit"
+        className="w-full bg-green-600 text-white py-3 px-6 rounded-lg font-medium hover:bg-green-700 active:bg-green-800 transition-colors"
+      >
+        Jetzt anmelden
+      </button>
+    </form>
+  );
+}
