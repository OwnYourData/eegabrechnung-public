+// MarkOnboardingActiveByMeterPoint flips the onboarding_request of the meter point's member
+// from 'eda_sent'/'converted' to 'active'. Called when registriert_seit is set manually
+// (external/manual EDA confirmation) so the 72h "Beitritt abschließen" reminders stop going
+// to already-full members. Best-effort; no-op when no matching request exists.
+func (r *MeterPointRepository) MarkOnboardingActiveByMeterPoint(ctx context.Context, meterPointID uuid.UUID) error {
+	_, err := r.db.Exec(ctx, `
+		UPDATE onboarding_requests
+		SET status = 'active', updated_at = now()
+		WHERE converted_member_id = (SELECT member_id FROM meter_points WHERE id = $1)
+		  AND status IN ('eda_sent', 'converted')`, meterPointID)
+	return err
+}
