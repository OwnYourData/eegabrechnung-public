+// notifyDeviceEvent informiert das eingeloggte Mitglied per E-Mail, dass ein Gerät
+// verbunden (connected=true) bzw. dessen Zugriff entzogen wurde (connected=false).
+//
+// Gegenmaßnahme gegen Vishing: Der manuelle 8-Zeichen-Code lässt sich am Telefon
+// vorlesen. Ein Warntext im Dialog hilft unter Zeitdruck wenig — die Mail macht den
+// Vorgang ENTDECKBAR und UMKEHRBAR.
+//
+// Regeln:
+//   - Empfänger ist die Adresse aus der Portal-Session (members.email). Die
+//     GrünLicht-API hat bewusst KEINEN Zugriff auf E-Mail-Adressen.
+//   - Gerätename/Zeitpunkt stammen aus dem bereits vorhandenen Pairing-/Session-
+//     Objekt — kein zusätzlicher API-Aufruf.
+//   - Fire-and-forget: Fehler werden geloggt, nie eskaliert.
+//   - KEINE Codes, KEINE Tokens, KEIN Auto-Login-Link. Nur ein Link ins Portal.
+func (h *MemberPortalHandler) notifyDeviceEvent(eegID, memberID uuid.UUID, deviceLabel, requestedAt string, connected bool) {
+	ctx := context.Background()
+
+	eeg, err := h.eegRepo.GetByIDInternal(ctx, eegID)
+	if err != nil || eeg == nil || eeg.SMTPHost == "" || eeg.IsDemo {
+		return // kein SMTP konfiguriert oder Demo-EEG: kein Versand
+	}
+	member, err := h.memberRepo.GetByID(ctx, memberID)
+	if err != nil || member == nil || strings.TrimSpace(member.Email) == "" {
+		return
+	}
+
+	if strings.TrimSpace(deviceLabel) == "" {
+		deviceLabel = "Unbekanntes Gerät"
+	}
+	when := time.Now().In(viennaLoc)
+	if t, perr := time.Parse(time.RFC3339, strings.TrimSpace(requestedAt)); perr == nil {
+		when = t.In(viennaLoc)
+	}
+	zeit := when.Format("02.01.2006, 15:04") + " Uhr"
+
+	name := strings.TrimSpace(member.Name1 + " " + member.Name2)
+	portalURL := strings.TrimRight(h.webBaseURL, "/") + "/portal"
+
+	var subject, body string
+	if connected {
+		subject = "Neues Gerät mit deinem EEG-GrünLicht-Konto verbunden"
+		body = `<p>Hallo ` + name + `,</p>
+<p>soeben wurde ein neues Gerät mit deinem Konto verbunden:</p>
+<p><strong>Gerät:</strong> ` + deviceLabel + `<br>
+<strong>Zeitpunkt:</strong> ` + zeit + `</p>
+<p>Warst du das? Dann ist alles in Ordnung, du musst nichts tun.</p>
+<p>Warst du das <strong>nicht</strong> &mdash; zum Beispiel, weil dich jemand telefonisch dazu
+gebracht hat, einen Code vorzulesen oder eine Verbindung zu bestätigen &mdash; dann entziehe dem
+Gerät sofort den Zugriff:</p>
+<p><a href="` + portalURL + `">Mitgliederportal öffnen → Tab „App verbinden" → Verbundene Geräte</a></p>
+<p><strong>Die EEG GrünLicht wird dich NIEMALS anrufen und nach einem Code fragen.</strong></p>`
+	} else {
+		subject = "Zugriff eines Geräts auf dein EEG-GrünLicht-Konto entzogen"
+		body = `<p>Hallo ` + name + `,</p>
+<p>der Zugriff des folgenden Geräts auf dein Konto wurde entzogen:</p>
+<p><strong>Gerät:</strong> ` + deviceLabel + `<br>
+<strong>Zeitpunkt:</strong> ` + zeit + `</p>
+<p>Warst du das? Dann ist alles in Ordnung.</p>
+<p>Warst du das <strong>nicht</strong>, melde dich bitte bei deiner Energiegemeinschaft:</p>
+<p><a href="` + portalURL + `">Mitgliederportal öffnen</a></p>`
+	}
+
+	msg := []byte(mailutil.Headers(eeg.SMTPFrom, member.Email, subject) +
+		"MIME-Version: 1.0\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n" + body)
+
+	cfg := invoice.SMTPConfig{Host: eeg.SMTPHost, From: eeg.SMTPFrom, Username: eeg.SMTPUser, Password: eeg.SMTPPassword}
+	emailType := "app_device_connected"
+	if !connected {
+		emailType = "app_device_revoked"
+	}
+	mid := memberID
+	if err := invoice.SendLogged(ctx, h.emailLogRepo, cfg, eeg.ID, emailType,
+		member.Email, subject, &mid, nil, msg); err != nil {
+		slog.Warn("device event mail failed", "type", emailType, "member_id", mid.String(), "error", err)
+	}
+}
