diff --git a/api/internal/handler/portal_app_pairing.go b/api/internal/handler/portal_app_pairing.go
new file mode 100644
index 0000000..5d13462
--- /dev/null
+++ b/api/internal/handler/portal_app_pairing.go
@@ -0,0 +1,248 @@
+package handler
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// Cluster-internal GrünLicht app API. Both values come from the environment/secret —
+// never from code. (Constant-time comparison of the shared secret happens on the API
+// side, which verifies it; billing is only the client and merely sends the header.)
+const (
+	envGruenlichtAPIURL   = "GRUENLICHT_API_INTERNAL" // e.g. http://gruenlicht-api.eegabrechnung.svc.cluster.local
+	envInternalServiceTok = "INTERNAL_SERVICE_TOKEN"  // sent as X-Service-Token
+)
+
+var gruenlichtClient = &http.Client{Timeout: 10 * time.Second}
+
+// appPairing is one open pairing request as returned by the GrünLicht API.
+type appPairing struct {
+	ID          json.Number `json:"id"`
+	PairingCode string      `json:"pairingCode"`
+	DeviceLabel string      `json:"deviceLabel"`
+	RequestedAt string      `json:"requestedAt"`
+}
+
+// appSession is one active app session (a connected device).
+type appSession struct {
+	ID          json.Number `json:"id"`
+	DeviceLabel string      `json:"deviceLabel"`
+	CreatedAt   string      `json:"createdAt"`
+	LastUsedAt  string      `json:"lastUsedAt"`
+}
+
+// gruenlichtCall performs an authenticated request against the internal GrünLicht API.
+// out (optional) is decoded from the response body on 200.
+func gruenlichtCall(method, path string, out any) (int, error) {
+	base := strings.TrimRight(strings.TrimSpace(os.Getenv(envGruenlichtAPIURL)), "/")
+	tok := strings.TrimSpace(os.Getenv(envInternalServiceTok))
+	if base == "" || tok == "" {
+		return 0, fmt.Errorf("gruenlicht api not configured")
+	}
+	req, err := http.NewRequest(method, base+path, nil)
+	if err != nil {
+		return 0, err
+	}
+	req.Header.Set("X-Service-Token", tok)
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := gruenlichtClient.Do(req)
+	if err != nil {
+		return 0, err
+	}
+	defer resp.Body.Close()
+
+	if out != nil && resp.StatusCode == http.StatusOK {
+		if err := json.NewDecoder(resp.Body).Decode(out); err != nil {
+			return resp.StatusCode, err
+		}
+		return resp.StatusCode, nil
+	}
+	_, _ = io.Copy(io.Discard, resp.Body)
+	return resp.StatusCode, nil
+}
+
+// listPairingsFor returns the OPEN pairing requests of exactly one member.
+func listPairingsFor(memberRef string) ([]appPairing, int, error) {
+	var items []appPairing
+	code, err := gruenlichtCall(http.MethodGet,
+		"/internal/pairings?member_ref="+url.QueryEscape(memberRef), &items)
+	return items, code, err
+}
+
+// listSessionsFor returns the ACTIVE app sessions of exactly one member.
+func listSessionsFor(memberRef string) ([]appSession, int, error) {
+	var items []appSession
+	code, err := gruenlichtCall(http.MethodGet,
+		"/internal/sessions?member_ref="+url.QueryEscape(memberRef), &items)
+	return items, code, err
+}
+
+// GetAppPairings returns the open pairing requests for the logged-in member.
+// Router: GET /api/v1/public/portal/app-pairings   (X-Portal-Session auth)
+func (h *MemberPortalHandler) GetAppPairings(w http.ResponseWriter, r *http.Request) {
+	memberID, _, ok := h.portalAuth(r)
+	if !ok {
+		jsonError(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	// SECURITY: member_ref ALWAYS comes from the session — never from the request.
+	items, code, err := listPairingsFor(memberID.String())
+	if err != nil {
+		jsonError(w, "pairing service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	if code != http.StatusOK {
+		jsonError(w, "pairing service error", http.StatusBadGateway)
+		return
+	}
+	if items == nil {
+		items = []appPairing{}
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(items)
+}
+
+// appPairingAction confirms or rejects a pairing request.
+//
+// SECURITY — this is the ENTIRE protection against a shoulder-surfed QR code:
+//   - reachable only from an authenticated portal session (portalAuth), and
+//   - the pairing MUST belong to the logged-in member. That is verified server-side by
+//     listing the member's OWN open pairings and requiring the id to be among them.
+//     member_ref comes from the session, NEVER from the request — so a caller cannot
+//     confirm a pairing that belongs to someone else.
+func (h *MemberPortalHandler) appPairingAction(w http.ResponseWriter, r *http.Request, action string) {
+	memberID, _, ok := h.portalAuth(r)
+	if !ok {
+		jsonError(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	id := strings.TrimSpace(chi.URLParam(r, "pairingID"))
+	if id == "" {
+		jsonError(w, "missing pairing id", http.StatusBadRequest)
+		return
+	}
+
+	items, code, err := listPairingsFor(memberID.String())
+	if err != nil || code != http.StatusOK {
+		jsonError(w, "pairing service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	owned := false
+	for _, it := range items {
+		if it.ID.String() == id {
+			owned = true
+			break
+		}
+	}
+	if !owned {
+		jsonError(w, "pairing does not belong to this member", http.StatusForbidden)
+		return
+	}
+
+	st, err := gruenlichtCall(http.MethodPost, "/internal/pairings/"+url.PathEscape(id)+"/"+action, nil)
+	if err != nil {
+		jsonError(w, "pairing service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	switch st {
+	case http.StatusNoContent:
+		w.WriteHeader(http.StatusNoContent)
+	case http.StatusNotFound:
+		jsonError(w, "pairing not found or no longer open", http.StatusNotFound)
+	case http.StatusGone:
+		jsonError(w, "pairing expired", http.StatusGone)
+	default:
+		jsonError(w, "pairing service error", http.StatusBadGateway)
+	}
+}
+
+// ConfirmAppPairing — POST /api/v1/public/portal/app-pairings/{pairingID}/confirm
+func (h *MemberPortalHandler) ConfirmAppPairing(w http.ResponseWriter, r *http.Request) {
+	h.appPairingAction(w, r, "confirm")
+}
+
+// RejectAppPairing — POST /api/v1/public/portal/app-pairings/{pairingID}/reject
+func (h *MemberPortalHandler) RejectAppPairing(w http.ResponseWriter, r *http.Request) {
+	h.appPairingAction(w, r, "reject")
+}
+
+// GetAppSessions lists the connected devices of the logged-in member.
+// Router: GET /api/v1/public/portal/app-sessions
+func (h *MemberPortalHandler) GetAppSessions(w http.ResponseWriter, r *http.Request) {
+	memberID, _, ok := h.portalAuth(r)
+	if !ok {
+		jsonError(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	items, code, err := listSessionsFor(memberID.String())
+	if err != nil {
+		jsonError(w, "session service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	if code != http.StatusOK {
+		jsonError(w, "session service error", http.StatusBadGateway)
+		return
+	}
+	if items == nil {
+		items = []appSession{}
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(items)
+}
+
+// RevokeAppSession revokes ("Zugriff entziehen") one connected device. Takes effect
+// immediately because the API keeps opaque, revocable sessions (no JWT).
+// SECURITY: same ownership rule — the session must belong to the logged-in member.
+// Router: DELETE /api/v1/public/portal/app-sessions/{sessionID}
+func (h *MemberPortalHandler) RevokeAppSession(w http.ResponseWriter, r *http.Request) {
+	memberID, _, ok := h.portalAuth(r)
+	if !ok {
+		jsonError(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+	id := strings.TrimSpace(chi.URLParam(r, "sessionID"))
+	if id == "" {
+		jsonError(w, "missing session id", http.StatusBadRequest)
+		return
+	}
+
+	items, code, err := listSessionsFor(memberID.String())
+	if err != nil || code != http.StatusOK {
+		jsonError(w, "session service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	owned := false
+	for _, it := range items {
+		if it.ID.String() == id {
+			owned = true
+			break
+		}
+	}
+	if !owned {
+		jsonError(w, "session does not belong to this member", http.StatusForbidden)
+		return
+	}
+
+	st, err := gruenlichtCall(http.MethodDelete, "/internal/sessions/"+url.PathEscape(id), nil)
+	if err != nil {
+		jsonError(w, "session service unavailable", http.StatusServiceUnavailable)
+		return
+	}
+	switch st {
+	case http.StatusNoContent:
+		w.WriteHeader(http.StatusNoContent)
+	case http.StatusNotFound:
+		jsonError(w, "session not found", http.StatusNotFound)
+	default:
+		jsonError(w, "session service error", http.StatusBadGateway)
+	}
+}
diff --git a/web/app/api/portal/app-pairings/[pairingId]/confirm/route.ts b/web/app/api/portal/app-pairings/[pairingId]/confirm/route.ts
new file mode 100644
index 0000000..5a20c16
--- /dev/null
+++ b/web/app/api/portal/app-pairings/[pairingId]/confirm/route.ts
@@ -0,0 +1,19 @@
+import { cookies } from "next/headers";
+const API = process.env.API_INTERNAL_URL || "http://localhost:8080";
+
+export async function POST(
+  _req: Request,
+  context: { params: Promise<{ pairingId: string }> }
+) {
+  const params = await context.params;
+  const cookieStore = await cookies();
+  const sessionToken = cookieStore.get("portal_session")?.value;
+  if (!sessionToken) return Response.json({ error: "Unauthorized" }, { status: 401 });
+
+  const res = await fetch(
+    `${API}/api/v1/public/portal/app-pairings/${params.pairingId}/confirm`,
+    { method: "POST", headers: { "X-Portal-Session": sessionToken } }
+  );
+  if (res.status === 204) return new Response(null, { status: 204 });
+  return Response.json({ error: "failed" }, { status: res.status });
+}
