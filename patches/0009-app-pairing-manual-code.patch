+-- Manueller Eingabe-Code (8 Zeichen Crockford-Base32) als Alternative zum QR.
+-- Zeigt auf DENSELBEN Pairing-Vorgang: gleiche TTL, gleiche Einmal-Nutzung.
+-- Gespeichert wird ausschließlich der SHA-256-Hex des normalisierten Codes —
+-- niemals der Klartext (der lebt nur auf dem Portal-Bildschirm).
+ALTER TABLE app_login_tokens ADD COLUMN IF NOT EXISTS code_hash text;
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_app_login_tokens_code_hash
+    ON app_login_tokens (code_hash) WHERE code_hash IS NOT NULL;
