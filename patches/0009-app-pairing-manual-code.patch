@@ -220,3 +238,20 @@ func base58Decode(s string) ([]byte, error) {
 	copy(out[leading:], decoded)
 	return out, nil
 }
+
+// crockfordAlphabet ohne I, L, O, U — verwechslungsarm beim Abtippen/Vorlesen.
+const crockfordAlphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
+
+// newPairingCode returns an 8-character Crockford-Base32 code (32^8 ~ 2^40).
+// 256 % 32 == 0, therefore the modulo mapping is bias-free.
+func newPairingCode() (string, error) {
+	b := make([]byte, 8)
+	if _, err := rand.Read(b); err != nil {
+		return "", err
+	}
+	out := make([]byte, 8)
+	for i, v := range b {
+		out[i] = crockfordAlphabet[int(v)%32]
+	}
+	return string(out), nil
+}
