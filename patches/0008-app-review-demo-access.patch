+-- Demo-Mitglied für die Apple-Beta-Review (TestFlight). Genau EIN Konto darf so
+-- markiert sein — der partielle Unique-Index erzwingt das.
+ALTER TABLE members ADD COLUMN IF NOT EXISTS is_demo BOOLEAN NOT NULL DEFAULT false;
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_members_single_demo
+    ON members (is_demo) WHERE is_demo = true;
diff --git a/api/internal/handler/portal_app_review.go b/api/internal/handler/portal_app_review.go
new file mode 100644
index 0000000..7e84c16
--- /dev/null
+++ b/api/internal/handler/portal_app_review.go
@@ -0,0 +1,118 @@
+package handler
+
+import (
+	"crypto/subtle"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"os"
+	"strings"
+)
+
+// Apple-Beta-Review (TestFlight) — dauerhafter Demo-Zugang, rein serverseitig.
+// Die App bekommt KEINEN Demo-Modus und keine Backdoor.
+const (
+	envAppReviewEnabled = "APP_REVIEW_ENABLED" // "true" schaltet den Link scharf; sonst 404
+	envAppReviewToken   = "APP_REVIEW_TOKEN"   // >= 32 Byte Zufall, jederzeit rotierbar
+)
+
+const appReviewMinTokenLen = 32
+
+// reviewEnabled reports whether the review link is armed.
+func reviewEnabled() bool {
+	return strings.EqualFold(strings.TrimSpace(os.Getenv(envAppReviewEnabled)), "true")
+}
+
+// ReviewExchange trades the APP_REVIEW_TOKEN for a normal portal session of the demo
+// member. There is no special review page — only a special *account*, no special *path*.
+//
+// SECURITY:
+//   - Kill-switch: APP_REVIEW_ENABLED != true  -> 404 (link is dead).
+//   - Constant-time comparison of the shared token; any mismatch -> 404 (never reveal
+//     whether the endpoint exists or the token was merely wrong).
+//   - The token authenticates EXACTLY ONE account: the single member flagged is_demo.
+//     It can never select another member — the id comes from the DB, never from the request.
+//   - That account is read-only (see DenyDemoMember middleware).
+//
+// Router: POST /api/v1/public/portal/review-exchange  (IP rate limited)
+func (h *MemberPortalHandler) ReviewExchange(w http.ResponseWriter, r *http.Request) {
+	if !reviewEnabled() {
+		http.NotFound(w, r)
+		return
+	}
+	want := strings.TrimSpace(os.Getenv(envAppReviewToken))
+	if len(want) < appReviewMinTokenLen {
+		slog.Error("app review: APP_REVIEW_TOKEN missing or too short — link disabled")
+		http.NotFound(w, r)
+		return
+	}
+
+	var req struct {
+		Token string `json:"token"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.NotFound(w, r)
+		return
+	}
+	got := strings.TrimSpace(req.Token)
+	if subtle.ConstantTimeCompare([]byte(got), []byte(want)) != 1 {
+		slog.Warn("app review: invalid token presented",
+			"remote", r.RemoteAddr, "xff", r.Header.Get("X-Forwarded-For"))
+		http.NotFound(w, r)
+		return
+	}
+
+	// The demo member is resolved from the DB (is_demo), never from the request.
+	memberID, eegID, err := h.portalRepo.FindDemoMember(r.Context())
+	if err != nil {
+		slog.Error("app review: no demo member found (is_demo)", "error", err)
+		http.NotFound(w, r)
+		return
+	}
+
+	linkToken, err := h.portalRepo.CreateLinkSession(r.Context(), memberID, eegID)
+	if err != nil {
+		jsonError(w, "failed to create review session", http.StatusInternalServerError)
+		return
+	}
+	sessionToken, _, _, err := h.portalRepo.ExchangeLinkToken(r.Context(), linkToken)
+	if err != nil {
+		jsonError(w, "failed to create review session", http.StatusInternalServerError)
+		return
+	}
+
+	// Alert: der Review-Link wurde benutzt.
+	slog.Warn("app review link used",
+		"member_id", memberID.String(),
+		"remote", r.RemoteAddr,
+		"xff", r.Header.Get("X-Forwarded-For"),
+		"ua", r.UserAgent())
+
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(map[string]string{"session_token": sessionToken})
+}
+
+// DenyDemoMember blocks every write action for the review/demo account. The account is
+// strictly read-only: no master-data changes, no IBAN/SEPA, no e-mail change. Pairing
+// confirm/reject and revoking app sessions stay allowed — the reviewer needs exactly those.
+func (h *MemberPortalHandler) DenyDemoMember(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		memberID, _, ok := h.portalAuth(r)
+		if !ok {
+			jsonError(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+		demo, err := h.portalRepo.IsDemoMember(r.Context(), memberID)
+		if err != nil {
+			jsonError(w, "internal error", http.StatusInternalServerError)
+			return
+		}
+		if demo {
+			slog.Warn("app review: write attempt blocked for demo account",
+				"path", r.URL.Path, "member_id", memberID.String())
+			jsonError(w, "Der Demo-Zugang ist schreibgeschützt.", http.StatusForbidden)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
