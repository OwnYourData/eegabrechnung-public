--- a/api/internal/repository/member_portal.go
+++ b/api/internal/repository/member_portal.go
@@ -228,3 +228,24 @@ func (r *MemberPortalRepository) DeleteExpiredAppLoginTokens(ctx context.Context
 	}
 	return tag.RowsAffected(), nil
 }
+
+// FindDemoMember returns the single member flagged is_demo (the Apple review account).
+// A partial unique index guarantees there is at most one.
+func (r *MemberPortalRepository) FindDemoMember(ctx context.Context) (memberID, eegID uuid.UUID, err error) {
+	err = r.db.QueryRow(ctx,
+		`SELECT id, eeg_id FROM members WHERE is_demo = true LIMIT 1`,
+	).Scan(&memberID, &eegID)
+	return memberID, eegID, err
+}
+
+// IsDemoMember reports whether the member is the review/demo account. Used to keep
+// that account strictly read-only.
+func (r *MemberPortalRepository) IsDemoMember(ctx context.Context, memberID uuid.UUID) (bool, error) {
+	var demo bool
+	if err := r.db.QueryRow(ctx,
+		`SELECT is_demo FROM members WHERE id = $1`, memberID,
+	).Scan(&demo); err != nil {
+		return false, err
+	}
+	return demo, nil
+}
