diff --git a/web/app/portal/review/route.ts b/web/app/portal/review/route.ts
new file mode 100644
index 0000000..3a309bf
--- /dev/null
+++ b/web/app/portal/review/route.ts
@@ -0,0 +1,43 @@
+import { NextRequest, NextResponse } from "next/server";
+
+const API = process.env.API_INTERNAL_URL || "http://localhost:8080";
+
+// Apple-Beta-Review-Einstieg: /portal/review?t=<APP_REVIEW_TOKEN>
+// Löst den Token serverseitig ein und meldet den Aufrufer im NORMALEN Portal als
+// Demo-Mitglied an. Keine Sonderseite — nur ein Sonder-Konto.
+export async function GET(request: NextRequest) {
+  const token = request.nextUrl.searchParams.get("t") ?? "";
+
+  const proto = request.headers.get("x-forwarded-proto") ?? "http";
+  const host =
+    request.headers.get("x-forwarded-host") ??
+    request.headers.get("host") ??
+    "localhost:3001";
+  const base = `${proto}://${host}`;
+
+  if (!token) return new NextResponse("Not found", { status: 404 });
+
+  const res = await fetch(`${API}/api/v1/public/portal/review-exchange`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ token }),
+    cache: "no-store",
+  });
+
+  // Kill-Switch oder falscher Token -> 404, nichts verraten.
+  if (!res.ok) return new NextResponse("Not found", { status: 404 });
+
+  const data = await res.json();
+  const sessionToken: string = data.session_token;
+
+  const response = NextResponse.redirect(`${base}/portal/dashboard`);
+  response.cookies.set("portal_session", sessionToken, {
+    httpOnly: true,
+    secure: process.env.NODE_ENV === "production",
+    sameSite: "lax",
+    maxAge: 24 * 60 * 60,
+    path: "/",
+  });
+  response.headers.set("X-Robots-Tag", "noindex, nofollow");
+  return response;
+}
