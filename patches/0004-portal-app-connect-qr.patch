@@ -206,3 +206,25 @@ func (r *MemberPortalRepository) ConfirmEmailChange(ctx context.Context, v *Emai
 
 	return oldEmail, tx.Commit(ctx)
 }
+
+// CreateAppLoginToken stores the SHA-256 hash of a freshly minted app login token.
+// SECURITY: the plaintext token is NEVER persisted and NEVER logged — it exists only
+// inside the QR code shown to the member. Billing does not mark tokens as consumed;
+// single-use is enforced by the GrünLicht API in its own database, so the API can stay
+// strictly read-only on this database.
+func (r *MemberPortalRepository) CreateAppLoginToken(ctx context.Context, tokenHash string, memberID uuid.UUID, ttlSeconds int) error {
+	_, err := r.db.Exec(ctx,
+		`INSERT INTO app_login_tokens (token_hash, member_id, expires_at)
+		 VALUES ($1, $2, now() + make_interval(secs => $3))`,
+		tokenHash, memberID, ttlSeconds)
+	return err
+}
+
+// DeleteExpiredAppLoginTokens purges tokens past their expiry. Returns the number of rows removed.
+func (r *MemberPortalRepository) DeleteExpiredAppLoginTokens(ctx context.Context) (int64, error) {
+	tag, err := r.db.Exec(ctx, `DELETE FROM app_login_tokens WHERE expires_at < now()`)
+	if err != nil {
+		return 0, err
+	}
+	return tag.RowsAffected(), nil
+}
diff --git a/web/app/api/portal/app-token/route.ts b/web/app/api/portal/app-token/route.ts
