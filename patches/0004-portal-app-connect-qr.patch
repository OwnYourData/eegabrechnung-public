@@ -0,0 +1,11 @@
+-- Short-lived login tokens for the GrünLicht mobile app QR code.
+-- SECURITY: only the SHA-256 hex hash of the token is stored — never the plaintext.
+CREATE TABLE IF NOT EXISTS app_login_tokens (
+    id          uuid        PRIMARY KEY DEFAULT gen_random_uuid(),
+    token_hash  text        NOT NULL UNIQUE,
+    member_id   uuid        NOT NULL REFERENCES members(id) ON DELETE CASCADE,
+    expires_at  timestamptz NOT NULL,
+    created_at  timestamptz NOT NULL DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS idx_app_login_tokens_expires_at ON app_login_tokens (expires_at);
diff --git a/api/internal/handler/portal_app_token.go b/api/internal/handler/portal_app_token.go
new file mode 100644
index 0000000..f3f011b
--- /dev/null
+++ b/api/internal/handler/portal_app_token.go
@@ -0,0 +1,222 @@
+package handler
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	qrcode "github.com/skip2/go-qrcode"
+)
+
+// Env vars for the member-portal "App verbinden" QR feature. Configure these on
+// the API deployment (same place as the DID / signing key).
+const (
+	envAppQRKid      = "PORTAL_APP_QR_KID"          // JWT header kid, e.g. did:oyd:...#key-doc
+	envAppQRPrivKey  = "PORTAL_APP_QR_PRIVKEY"      // ES256 private key, multibase encoded
+	envAppQRTTL      = "PORTAL_APP_QR_TTL_SECONDS"  // token lifetime in seconds (default 180)
+	envAppIOSURL     = "PORTAL_APP_IOS_URL"         // App Store link
+	envAppAndroidURL = "PORTAL_APP_ANDROID_URL"     // Play Store link
+)
+
+// defaultAppQRTTLSeconds is the fallback token lifetime when PORTAL_APP_QR_TTL_SECONDS
+// is unset or invalid. The QR is scanned immediately, so a few minutes is plenty.
+const defaultAppQRTTLSeconds = 180
+
+// GetAppToken issues a signed ES256 JWT for the logged-in portal member and
+// returns it together with a QR-code image (PNG data URL) and the app store links.
+// Router: GET /api/v1/public/portal/app-token  (X-Portal-Session auth)
+func (h *MemberPortalHandler) GetAppToken(w http.ResponseWriter, r *http.Request) {
+	memberID, _, ok := h.portalAuth(r)
+	if !ok {
+		jsonError(w, "unauthorized", http.StatusUnauthorized)
+		return
+	}
+
+	kid := strings.TrimSpace(os.Getenv(envAppQRKid))
+	privMB := strings.TrimSpace(os.Getenv(envAppQRPrivKey))
+	if kid == "" || privMB == "" {
+		jsonError(w, "app connect not configured", http.StatusServiceUnavailable)
+		return
+	}
+
+	priv, err := parseP256PrivKeyMultibase(privMB)
+	if err != nil {
+		jsonError(w, "app signing key error: "+err.Error(), http.StatusInternalServerError)
+		return
+	}
+
+	ttl := appTokenTTL()
+
+	// Random login token (CSPRNG, 32 bytes). The plaintext lives ONLY inside the QR code:
+	// it is never persisted and never logged — the DB only ever stores its SHA-256 hash.
+	rawTok := make([]byte, 32)
+	if _, err := rand.Read(rawTok); err != nil {
+		jsonError(w, "failed to generate login token", http.StatusInternalServerError)
+		return
+	}
+	loginToken := base64.RawURLEncoding.EncodeToString(rawTok)
+	sum := sha256.Sum256([]byte(loginToken))
+	tokenHash := hex.EncodeToString(sum[:])
+
+	if err := h.portalRepo.CreateAppLoginToken(r.Context(), tokenHash, memberID, int(ttl.Seconds())); err != nil {
+		jsonError(w, "failed to store login token", http.StatusInternalServerError)
+		return
+	}
+
+	jwtStr, err := signAppJWT(priv, kid, loginToken, ttl)
+	if err != nil {
+		jsonError(w, "failed to sign token", http.StatusInternalServerError)
+		return
+	}
+
+	png, err := qrcode.Encode(jwtStr, qrcode.Medium, 320)
+	if err != nil {
+		jsonError(w, "failed to render qr", http.StatusInternalServerError)
+		return
+	}
+
+	// The signed JWT (and thus the login token) is deliberately NOT returned in the JSON
+	// body — it exists only inside the rendered QR image.
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(map[string]string{
+		"qr":          "data:image/png;base64," + base64.StdEncoding.EncodeToString(png),
+		"ios_url":     strings.TrimSpace(os.Getenv(envAppIOSURL)),
+		"android_url": strings.TrimSpace(os.Getenv(envAppAndroidURL)),
+		"expires_in":  strconv.Itoa(int(ttl.Seconds())),
+	})
+}
+
+// appTokenTTL reads PORTAL_APP_QR_TTL_SECONDS, falling back to the default when
+// unset, non-numeric or <= 0.
+func appTokenTTL() time.Duration {
+	if v := strings.TrimSpace(os.Getenv(envAppQRTTL)); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n > 0 {
+			return time.Duration(n) * time.Second
+		}
+	}
+	return time.Duration(defaultAppQRTTLSeconds) * time.Second
+}
+
+// signAppJWT builds a compact ES256 JWT: header{alg,typ,kid}.payload{tok,iat,exp}.signature.
+// The payload carries ONLY a short-lived random token — no member identifier, no PII.
+func signAppJWT(priv *ecdsa.PrivateKey, kid, tok string, ttl time.Duration) (string, error) {
+	header := struct {
+		Alg string `json:"alg"`
+		Typ string `json:"typ"`
+		Kid string `json:"kid"`
+	}{Alg: "ES256", Typ: "JWT", Kid: kid}
+
+	now := time.Now().Unix()
+	payload := struct {
+		Tok string `json:"tok"`
+		Iat int64  `json:"iat"`
+		Exp int64  `json:"exp"`
+	}{Tok: tok, Iat: now, Exp: now + int64(ttl.Seconds())}
+
+	hb, err := json.Marshal(header)
+	if err != nil {
+		return "", err
+	}
+	pb, err := json.Marshal(payload)
+	if err != nil {
+		return "", err
+	}
+	b64 := base64.RawURLEncoding
+	signingInput := b64.EncodeToString(hb) + "." + b64.EncodeToString(pb)
+
+	digest := sha256.Sum256([]byte(signingInput))
+	rInt, sInt, err := ecdsa.Sign(rand.Reader, priv, digest[:])
+	if err != nil {
+		return "", err
+	}
+	// ES256 signature = R || S, each left-padded to 32 bytes.
+	sig := make([]byte, 64)
+	rInt.FillBytes(sig[0:32])
+	sInt.FillBytes(sig[32:64])
+	return signingInput + "." + b64.EncodeToString(sig), nil
+}
+
+// parseP256PrivKeyMultibase decodes a multibase-encoded private key and returns
+// the P-256 private key. The 32-byte private scalar is taken as the LAST 32 bytes
+// of the decoded value, so any preceding multibase/multicodec prefix is tolerated
+// (standard p256-priv 0x1306, OYD's 2-byte-codec+length prefix, or a raw scalar).
+func parseP256PrivKeyMultibase(mb string) (*ecdsa.PrivateKey, error) {
+	raw, err := decodeMultibase(strings.TrimSpace(mb))
+	if err != nil {
+		return nil, err
+	}
+	if len(raw) < 32 {
+		return nil, fmt.Errorf("decoded key too short: %d bytes", len(raw))
+	}
+	scalar := raw[len(raw)-32:]
+	priv := new(ecdsa.PrivateKey)
+	priv.Curve = elliptic.P256()
+	priv.D = new(big.Int).SetBytes(scalar)
+	priv.PublicKey.X, priv.PublicKey.Y = priv.Curve.ScalarBaseMult(scalar)
+	return priv, nil
+}
+
+// decodeMultibase decodes the common multibase encodings by their prefix char
+// (z=base58btc, u/U=base64url, m/M=base64, f/F=base16).
+func decodeMultibase(s string) ([]byte, error) {
+	if s == "" {
+		return nil, fmt.Errorf("empty multibase string")
+	}
+	prefix, rest := s[0], s[1:]
+	switch prefix {
+	case 'z':
+		return base58Decode(rest)
+	case 'u':
+		return base64.RawURLEncoding.DecodeString(rest)
+	case 'U':
+		return base64.URLEncoding.DecodeString(rest)
+	case 'm':
+		return base64.RawStdEncoding.DecodeString(rest)
+	case 'M':
+		return base64.StdEncoding.DecodeString(rest)
+	case 'f':
+		return hex.DecodeString(rest)
+	case 'F':
+		return hex.DecodeString(strings.ToLower(rest))
+	default:
+		return nil, fmt.Errorf("unsupported multibase prefix %q", string(prefix))
+	}
+}
+
+// base58Decode decodes a base58btc (Bitcoin alphabet) string.
+func base58Decode(s string) ([]byte, error) {
+	const alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
+	result := big.NewInt(0)
+	radix := big.NewInt(58)
+	for _, c := range s {
+		idx := strings.IndexRune(alphabet, c)
+		if idx < 0 {
+			return nil, fmt.Errorf("invalid base58 char %q", string(c))
+		}
+		result.Mul(result, radix)
+		result.Add(result, big.NewInt(int64(idx)))
+	}
+	decoded := result.Bytes()
+	leading := 0
+	for _, c := range s {
+		if c == '1' {
+			leading++
+		} else {
+			break
+		}
+	}
+	out := make([]byte, leading+len(decoded))
+	copy(out[leading:], decoded)
+	return out, nil
+}
