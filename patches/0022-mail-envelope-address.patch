diff --git a/api/internal/mailutil/header.go b/api/internal/mailutil/header.go
index f8a2f97..72d5791 100644
--- a/api/internal/mailutil/header.go
+++ b/api/internal/mailutil/header.go
@@ -92,6 +92,30 @@ func isPlainDisplayName(name string) bool {
 	return true
 }
 
+// EnvelopeAddress returns the bare mail address (local@domain) from a value that may
+// also be in "Name <addr>" form. SMTP MAIL FROM and RCPT TO must carry the address
+// only: net/smtp writes the given string raw into the command, so a display name
+// would produce MAIL FROM:<Name <addr>> and the server answers 501.
+//
+// Falls back to the sanitised raw value when the input does not parse as an address,
+// so a questionable value is never made worse.
+func EnvelopeAddress(s string) string {
+	s = SanitizeHeaderValue(s)
+	if addr, err := mail.ParseAddress(s); err == nil {
+		return addr.Address
+	}
+	return s
+}
+
+// EnvelopeAddresses maps EnvelopeAddress over a recipient list (RCPT TO).
+func EnvelopeAddresses(ss []string) []string {
+	out := make([]string, len(ss))
+	for i, s := range ss {
+		out[i] = EnvelopeAddress(s)
+	}
+	return out
+}
+
 // ComposeFrom decides which From value to use.
 //
 //   - configuredFrom already carries a display name ("EEG X <a@b>"): returned
diff --git a/api/internal/mailutil/header_test.go b/api/internal/mailutil/header_test.go
index 249e3ed..a9c7a3d 100644
--- a/api/internal/mailutil/header_test.go
+++ b/api/internal/mailutil/header_test.go
@@ -163,3 +163,65 @@ func TestHeadersFromEncodesFallbackNameWithUmlaut(t *testing.T) {
 		t.Fatalf("expected encoded name before plain address, got %q", h)
 	}
 }
+
+// --- EnvelopeAddress -----------------------------------------------------
+
+func TestEnvelopeAddressStripsDisplayName(t *testing.T) {
+	got := EnvelopeAddress("EEG Gruenes Licht Bad Voeslau Sooss <kontakt@eeg-gruenlicht.at>")
+	if got != "kontakt@eeg-gruenlicht.at" {
+		t.Fatalf("EnvelopeAddress = %q, want bare address", got)
+	}
+}
+
+func TestEnvelopeAddressBareUnchanged(t *testing.T) {
+	in := "kontakt@eeg-gruenlicht.at"
+	if got := EnvelopeAddress(in); got != in {
+		t.Fatalf("EnvelopeAddress = %q, want %q", got, in)
+	}
+}
+
+func TestEnvelopeAddressUmlautDisplayName(t *testing.T) {
+	got := EnvelopeAddress("EEG Grünes Licht Bad Vöslau <kontakt@eeg-gruenlicht.at>")
+	if got != "kontakt@eeg-gruenlicht.at" {
+		t.Fatalf("EnvelopeAddress = %q, want bare address", got)
+	}
+}
+
+func TestEnvelopeAddressUnparsableFallsBack(t *testing.T) {
+	if got := EnvelopeAddress("not an address"); got != "not an address" {
+		t.Fatalf("EnvelopeAddress = %q, want sanitised raw value", got)
+	}
+	if got := EnvelopeAddress(""); got != "" {
+		t.Fatalf("EnvelopeAddress(\"\") = %q, want empty", got)
+	}
+}
+
+func TestEnvelopeAddressStripsInjection(t *testing.T) {
+	got := EnvelopeAddress("kontakt@eeg.at\r\nRCPT TO:<evil@x.at>")
+	if contains(got, "\r") || contains(got, "\n") {
+		t.Fatalf("CR/LF survived into envelope: %q", got)
+	}
+}
+
+func TestEnvelopeAddressesMapsList(t *testing.T) {
+	got := EnvelopeAddresses([]string{
+		"EEG X <a@b.at>",
+		"plain@c.at",
+	})
+	if len(got) != 2 || got[0] != "a@b.at" || got[1] != "plain@c.at" {
+		t.Fatalf("EnvelopeAddresses = %#v", got)
+	}
+}
+
+// The point of patches 0021 + 0022 together: one configured value yields a full
+// display name in the header but a bare address in the SMTP envelope.
+func TestHeaderKeepsNameEnvelopeStripsIt(t *testing.T) {
+	configured := "EEG Gruenes Licht Bad Voeslau Sooss <kontakt@eeg-gruenlicht.at>"
+	h := Headers(ComposeFrom(configured, "EEG Grünes Licht Bad Vöslau"), "m@example.at", "Test")
+	if !contains(h, "From: "+configured+"\r\n") {
+		t.Fatalf("header lost the display name: %q", h)
+	}
+	if env := EnvelopeAddress(configured); env != "kontakt@eeg-gruenlicht.at" {
+		t.Fatalf("envelope = %q, want bare address", env)
+	}
+}
