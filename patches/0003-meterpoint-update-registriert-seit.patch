+// SetOpenPeriodStart aktualisiert registriert_seit (Perioden-Beginn) der aktuell offenen
+// Periode eines Zählpunkts. No-op, wenn keine offen ist. Fuer manuelle Datumskorrekturen.
+func (r *MeterPointRegistrationPeriodRepository) SetOpenPeriodStart(ctx context.Context, eegID uuid.UUID, zaehlpunkt string, date time.Time) error {
+	_, err := r.db.Exec(ctx,
+		`UPDATE meter_point_registration_periods
+		 SET registriert_seit = $3
+		 WHERE eeg_id = $1 AND zaehlpunkt = $2 AND abgemeldet_am IS NULL`,
+		eegID, zaehlpunkt, date.UTC().Truncate(24*time.Hour),
+	)
+	if err != nil {
+		return fmt.Errorf("update open registration period start: %w", err)
+	}
+	return nil
+}
