@@ -0,0 +1,157 @@
+package handler
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/subtle"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/lutzerb/eegabrechnung/internal/invoice"
+	"github.com/lutzerb/eegabrechnung/internal/mailutil"
+)
+
+// envInternalServiceToken is the shared secret the GrünLicht API presents (header
+// X-Service-Token) when calling this internal endpoint. It is the SAME secret used in
+// the other direction (portal -> GrünLicht API, see portal_app_pairing.go).
+const envInternalServiceToken = "INTERNAL_SERVICE_TOKEN"
+
+// emailPairingTTL is the lifetime of an email-pairing token — short, because the link
+// is tapped straight from the mail. Single-use is enforced by the GrünLicht API.
+const emailPairingTTL = 10 * time.Minute
+
+// AppPairEmail handles POST /internal/app/pair/email.
+//
+// The app's email pairing endpoint (POST /api/app/pair/email on the GrünLicht API)
+// proxies here AFTER its own rate-limit + generic response. This logic lives on the
+// billing side because only it holds the ES256 signing key, the members' e-mail
+// addresses and the per-EEG SMTP credentials — none of which are exposed to the
+// read-only GrünLicht API.
+//
+// For every ACTIVE member with the given address we mint a fresh QR-format pairing
+// token (payload {tok,iat,exp,src:"email"}) tagged source='email' in the DB and mail
+// the link https://<web>/app/pair?t=<jwt>. A person in several EEGs gets one mail per
+// membership (each via that EEG's SMTP). Demo EEGs never send.
+//
+// SECURITY:
+//   - Caller auth: constant-time X-Service-Token compare. Reachable only in-cluster.
+//   - No member-existence signal: always 202 once authenticated, whether or not the
+//     address matched. Enumeration protection + rate-limit live on the GrünLicht API.
+func (h *MemberPortalHandler) AppPairEmail(w http.ResponseWriter, r *http.Request) {
+	expected := strings.TrimSpace(os.Getenv(envInternalServiceToken))
+	if expected == "" {
+		http.Error(w, "internal endpoint not configured", http.StatusServiceUnavailable)
+		return
+	}
+	got := strings.TrimSpace(r.Header.Get("X-Service-Token"))
+	if subtle.ConstantTimeCompare([]byte(got), []byte(expected)) != 1 {
+		http.Error(w, "forbidden", http.StatusUnauthorized)
+		return
+	}
+
+	var req struct {
+		Email string `json:"email"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil || strings.TrimSpace(req.Email) == "" {
+		http.Error(w, "invalid request", http.StatusBadRequest)
+		return
+	}
+	email := strings.TrimSpace(req.Email)
+
+	kid := strings.TrimSpace(os.Getenv(envAppQRKid))
+	privMB := strings.TrimSpace(os.Getenv(envAppQRPrivKey))
+	if kid == "" || privMB == "" {
+		http.Error(w, "app connect not configured", http.StatusServiceUnavailable)
+		return
+	}
+	priv, err := parseP256PrivKeyMultibase(privMB)
+	if err != nil {
+		http.Error(w, "app signing key error", http.StatusInternalServerError)
+		return
+	}
+
+	// One pairing mail per ACTIVE membership with this address. Unknown address ->
+	// the loop runs zero times and we still answer 202.
+	choices, err := h.portalRepo.FindMembersByEmail(r.Context(), email)
+	if err != nil {
+		slog.Error("AppPairEmail: member lookup failed", "error", err)
+		choices = nil
+	}
+	for _, c := range choices {
+		if c.IsDemo {
+			continue
+		}
+		rawTok := make([]byte, 32)
+		if _, err := rand.Read(rawTok); err != nil {
+			slog.Error("AppPairEmail: token rand failed", "error", err)
+			continue
+		}
+		loginToken := base64.RawURLEncoding.EncodeToString(rawTok)
+		sum := sha256.Sum256([]byte(loginToken))
+		tokenHash := hex.EncodeToString(sum[:])
+
+		if err := h.portalRepo.CreateAppLoginTokenEmail(r.Context(), tokenHash, c.MemberID, int(emailPairingTTL.Seconds())); err != nil {
+			slog.Error("AppPairEmail: store token failed", "error", err, "member_id", c.MemberID)
+			continue
+		}
+		jwtStr, err := signAppJWT(priv, kid, loginToken, "email", emailPairingTTL)
+		if err != nil {
+			slog.Error("AppPairEmail: sign failed", "error", err)
+			continue
+		}
+		link := strings.TrimRight(h.webBaseURL, "/") + "/app/pair?t=" + jwtStr
+		name := strings.TrimSpace(c.Name1 + " " + c.Name2)
+		go h.sendAppPairEmail(c.EegID, c.EegName, c.Email, name, link)
+	}
+
+	w.WriteHeader(http.StatusAccepted)
+}
+
+// sendAppPairEmail mails the pairing link via the member's EEG SMTP. Mirrors
+// sendPortalLinkEmail. The mail carries no secret beyond the short-lived one-time link.
+func (h *MemberPortalHandler) sendAppPairEmail(eegID uuid.UUID, eegName, toEmail, name, link string) {
+	eeg, err := h.eegRepo.GetByIDInternal(context.Background(), eegID)
+	if err != nil || eeg == nil || eeg.SMTPHost == "" {
+		slog.Error("sendAppPairEmail: EEG SMTP not configured", "eeg_id", eegID)
+		return
+	}
+	fullName := strings.TrimSpace(name)
+	if fullName == "" {
+		fullName = "Mitglied"
+	}
+	community := strings.TrimSpace(eegName)
+	if community == "" {
+		community = eeg.Name
+	}
+	subject := "EEG GrünLicht App verbinden"
+	body := fmt.Sprintf(`Sehr geehrte/r %s,
+
+tippen Sie den folgenden Link auf dem Handy an, auf dem die EEG-GrünLicht-App installiert ist, um die App mit Ihrem Zugang bei %s zu verbinden:
+
+%s
+
+Der Link ist 10 Minuten gültig und kann nur einmal verwendet werden.
+
+Falls Sie diese Verbindung nicht angefordert haben, können Sie diese E-Mail ignorieren.
+
+Mit freundlichen Grüßen
+Ihr EEG-Team`, fullName, community, link)
+
+	msg := []byte(mailutil.Headers(eeg.SMTPFrom, toEmail, subject) +
+		"Content-Type: text/plain; charset=UTF-8\r\n" +
+		"\r\n" +
+		body)
+	cfg := invoice.SMTPConfig{Host: eeg.SMTPHost, From: eeg.SMTPFrom, Username: eeg.SMTPUser, Password: eeg.SMTPPassword}
+	if err := invoice.SendLogged(context.Background(), h.emailLogRepo, cfg, eeg.ID, "app_pair_email", toEmail, subject, nil, nil, msg); err != nil {
+		slog.Error("sendAppPairEmail: failed to send", "error", err, "to", toEmail)
+	}
+}
