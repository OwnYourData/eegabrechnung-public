+
+// CreateAppLoginTokenEmail stores the SHA-256 hash of an email-pairing login token.
+// Unlike the QR flow there is no manual short code (code_hash stays NULL), and the
+// row is tagged source='email' so the GrünLicht API can auto-confirm the pairing:
+// the link went only to the member's registered address, which is the identity proof.
+// SECURITY: only the hash is persisted, never the plaintext token.
+func (r *MemberPortalRepository) CreateAppLoginTokenEmail(ctx context.Context, tokenHash string, memberID uuid.UUID, ttlSeconds int) error {
+	_, err := r.db.Exec(ctx,
+		`INSERT INTO app_login_tokens (token_hash, member_id, expires_at, source)
+		 VALUES ($1, $2, now() + make_interval(secs => $3), 'email')`,
+		tokenHash, memberID, ttlSeconds)
+	return err
+}
