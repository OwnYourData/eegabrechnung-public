+-- Provenance of an app login token: 'qr' (portal QR / manual code, the default and
+-- existing behaviour) or 'email' (magic-link mailed to the registered address).
+-- The GrünLicht API reads this via app_readonly.app_login_token_view and auto-confirms
+-- ONLY email-sourced pairings (the link went solely to the member's own address).
+ALTER TABLE app_login_tokens ADD COLUMN IF NOT EXISTS source text NOT NULL DEFAULT 'qr';
diff --git a/api/internal/handler/portal_app_email_pairing.go b/api/internal/handler/portal_app_email_pairing.go
